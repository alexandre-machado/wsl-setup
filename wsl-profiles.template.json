{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "defaultDistribution": "Ubuntu",
  "defaultVersion": "24.04",
  "dataDiskPath": "D:\\wsl\\data\\repos.vhdx",
  "dataDiskMountName": "repos",
  "setDefaultDistro": "Ubuntu-Personal",
  "replaceExisting": false,
  "provisionGit": true,
  "distros": [
    {
      "name": "Ubuntu-Personal",
      "distribution": "Ubuntu",
      "version": "24.04",
      "installLocation": "%LOCALAPPDATA%\\wsl\\Ubuntu-Personal",
      "gitName": "Your Name",
      "gitEmail": "your.email@example.com"
    },
    {
      "name": "Ubuntu-Work",
      "distribution": "Ubuntu",
      "version": "24.04",
      "installLocation": "%LOCALAPPDATA%\\wsl\\Ubuntu-Work",
      "gitName": "Your Name",
      "gitEmail": "your.work.email@example.com"
    },
    {
      "name": "Ubuntu-CI",
      "distribution": "Ubuntu",
      "version": "24.04",
      "installLocation": "%LOCALAPPDATA%\\wsl\\Ubuntu-CI",
      "mountDataDisk": false,
      "isolated": true
    },
    {
      "name": "Debian-Lab",
      "distribution": "Debian",
      "version": "12",
      "installLocation": "%LOCALAPPDATA%\\wsl\\Debian-Lab",
      "mountDataDisk": false,
      "isolated": true
    },
    {
      "name": "Alpine-Micro",
      "distribution": "Alpine",
      "version": "3.20",
      "installLocation": "%LOCALAPPDATA%\\wsl\\Alpine-Micro",
      "mountDataDisk": false,
      "isolated": true
    }
  ]
}
